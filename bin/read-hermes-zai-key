#!/usr/bin/env python3
"""Read one allowlisted Z.AI key from a locked-down Hermes dotenv file."""

from __future__ import annotations

import os
from pathlib import Path
import stat
import sys


KEY_PRIORITY = ("Z_AI_API_KEY", "ZAI_API_KEY", "GLM_API_KEY")


def parse_dotenv(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        if "=" not in line:
            continue
        name, value = line.split("=", 1)
        name = name.strip()
        if name not in KEY_PRIORITY:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[name] = value
    return values


def main() -> int:
    path = Path(os.environ.get("HERMES_ENV_FILE", Path.home() / ".hermes" / ".env"))
    try:
        metadata = path.lstat()
    except OSError:
        return 1
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        return 1
    if metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
        return 1
    try:
        values = parse_dotenv(path)
    except (OSError, UnicodeError):
        return 1
    for name in KEY_PRIORITY:
        if values.get(name):
            sys.stdout.write(values[name])
            return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
