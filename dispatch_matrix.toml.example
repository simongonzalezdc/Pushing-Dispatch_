# dispatch_matrix.toml - The single source of truth for executor configuration.
#
# This file defines every executor, its capabilities, allowed modes,
# cost caps, routing heuristics, and nested-dispatch permissions.
#
# Copy this file to dispatch_matrix.toml and customize for your setup.
# The CLI reads this file at startup to derive executor choices.

schema_version = 1

# ============================================================
# Executors
# ============================================================
# Each executor is a model+provider combination with a thin wrapper.
# Required fields: wrapper, provider, allowed_modes
# Optional: model_id, default_thinking_tokens, thinking_hard_ceiling,
#           context_window, max_turns, stall_threshold_seconds,
#           hard_wall_block_breakout_top, hard_wall_block_task_top

[executors.opus]
wrapper = "opus.sh"
provider = "anthropic"
model_id = "claude-opus-4-8"
allowed_modes = ["breakout", "task", "consult"]
allowed_seats_in_breakout = ["top", "review"]
default_thinking_tokens = 4000
thinking_hard_ceiling = 16000
context_window = 1000000  # Opus 4.7 1M-context plan. Falls back to 200K on standard tier.
stall_threshold_seconds = 600

[executors.sonnet]
wrapper = "sonnet.sh"
provider = "anthropic"
model_id = "claude-sonnet-4-6"
allowed_modes = ["breakout", "task", "consult"]
allowed_seats_in_breakout = ["top", "review", "engineer"]
default_thinking_tokens = 4000
thinking_hard_ceiling = 16000
context_window = 200000  # Bump to 1000000 if you have the context-1m-2025-08-07 beta header enabled.
stall_threshold_seconds = 600

[executors.haiku]
wrapper = "haiku.sh"
provider = "anthropic"
model_id = "claude-haiku-4-5-20251001"
allowed_modes = ["task"]
allowed_seats_in_breakout = ["leaf"]
default_thinking_tokens = 0
thinking_hard_ceiling = 2000
context_window = 200000
max_turns = 50
stall_threshold_seconds = 300
# Haiku is a leaf executor: cannot dispatch sub-workers
hard_wall_block_breakout_top = true

[executors.kimi-coding]
key_env = "KIMI_API_KEY"
key_account = "kimi_api_key"
wrapper = "kimi-coding.sh"
provider = "kimi-coding"
model_id = "kimi-for-coding"
allowed_modes = ["breakout", "task"]
allowed_seats_in_breakout = ["engineer"]
default_thinking_tokens = 0        # thinking disabled for mechanical work
thinking_hard_ceiling = 32768
context_window = 256000            # Manifest Kimi Coding custom provider
max_turns = 25
stall_threshold_seconds = 300

[executors.kimi-moonshot]
key_env = "MOONSHOT_API_KEY"
key_account = "moonshot_api_key"
wrapper = "moonshot.sh"
provider = "kimi-cli"
model_id = "kimi-code/kimi-for-coding"
allowed_modes = ["breakout", "task", "consult"]
allowed_seats_in_breakout = ["engineer", "review"]
default_thinking_tokens = 0
thinking_hard_ceiling = 16000
context_window = 262144
max_turns = 25
stall_threshold_seconds = 600

[executors.deepseek]
key_env = "DEEPSEEK_API_KEY"
key_account = "deepseek_api_key"
wrapper = "deepseek.sh"
provider = "deepseek"
model_id = "deepseek-v4-flash"
allowed_modes = ["task", "consult"]
allowed_seats_in_breakout = ["engineer", "leaf"]
default_thinking_tokens = 4000
thinking_hard_ceiling = 16000
