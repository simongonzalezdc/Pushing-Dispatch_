# ============================================================
# Auto-routing heuristics
# ============================================================
# Consulted by the auto-router when no explicit executor is set.
# Keys are signal names, values are executor preferences.

[auto_route]
# Ordered candidate lists per tier. The router returns the first executor that
# is mode-allowed AND available AND not in cooldown. Adaptive-balanced: hard and
# deep tiers lead with stronger models; trivial/standard lead with cheaper ones.
trivial_candidates        = ["zai-glm", "minimax", "nucbox-gemma4", "openai-mini", "haiku"]
standard_candidates       = ["zai-glm", "minimax", "nucbox-gemma4", "codex-spark", "sonnet"]
hard_task_candidates      = ["zai-glm", "minimax", "nucbox-gemma4", "openai-gpt55-high", "opus"]
hard_breakout_candidates  = ["zai-glm", "minimax", "nucbox-gemma4", "openai-gpt55-high", "opus"]
long_context_candidates   = ["zai-glm", "minimax", "nucbox-gemma4", "kimi-coding", "gemini-pro"]
consult_candidates        = ["zai-glm", "minimax", "nucbox-gemma4", "opus"]

# Back-compat single-value keys (read only if the matching *_candidates list is
# absent). Kept so older tooling / partial matrices still resolve.
long_context_executor = "kimi-coding"
long_context_threshold_tokens = 50000
trivial_executor = "zai-glm"
trivial_threshold_tokens = 5000
hard_coding_breakout_executor = "zai-glm"
hard_coding_task_executor = "zai-glm"
default_breakout = "zai-glm"
default_task = "zai-glm"
default_consult = "zai-glm"

# Learning loop: when true, candidate ordering is re-biased by outcomes.jsonl
# history (success rate / cost per tier). Off by default; enable after data
# accumulates.
learning = false

# ============================================================
# Nested dispatch configuration
# ============================================================

[nested_dispatch]
# Maximum nesting depth. Design target: 3. Now at 2 for orchestrator ->
# sub-orchestrator -> workers. Availability + cooldown filtering applies to
# child dispatches too; self-dispatch remains denied.
max_depth = 2

# Feature flag: set DISPATCH_NESTED=1 env var to enable.
# When off, --parent-id and --depth flags are silently ignored.

[nested_dispatch.permissions]
# Format: parent.child = true|false
# Missing entries are treated as denied.
# Self-dispatch is always denied regardless of matrix entries.

# Opus can dispatch anything except itself
"opus.sonnet" = true
"opus.haiku" = true
"opus.kimi-coding" = true
"opus.kimi-moonshot" = true
"opus.deepseek" = true
"opus.zai-glm" = true
