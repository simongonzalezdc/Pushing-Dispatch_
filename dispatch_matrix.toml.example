# dispatch_matrix.toml - The single source of truth for executor configuration.
#
# This file defines every executor, its capabilities, allowed modes,
# cost caps, routing heuristics, and nested-dispatch permissions.
#
# Copy this file to dispatch_matrix.toml and customize for your setup.
# The CLI reads this file at startup to derive executor choices.

schema_version = 1

# ============================================================
# Executors
# ============================================================
# Each executor is a model+provider combination with a thin wrapper.
# Required fields: wrapper, provider, allowed_modes
# Optional: capabilities (for example ["vision"]), model_id,
#           default_thinking_tokens, thinking_hard_ceiling,
#           context_window, max_turns, stall_threshold_seconds,
#           hard_wall_block_breakout_top, hard_wall_block_task_top

[executors.kimi-k3-cli]
wrapper = "kimi-k3-cli.sh"
provider = "kimi-cli"
model_id = "kimi-code/k3"
allowed_modes = ["breakout", "task", "consult"]
capabilities = ["vision"]
allowed_seats_in_breakout = ["engineer", "review"]
default_thinking_tokens = 0
thinking_hard_ceiling = 16000
context_window = 1048576
max_turns = 25
stall_threshold_seconds = 600

[executors.kimi-k3-ollama]
key_env = "OLLAMA_API_KEY"
key_account = "ollama_api_key"
wrapper = "kimi-k3-ollama-cloud.sh"
provider = "ollama-cloud"
model_id = "kimi-k3"
allowed_modes = ["breakout", "task", "consult"]
capabilities = ["vision"]
allowed_seats_in_breakout = ["engineer", "review"]
default_thinking_tokens = 0
thinking_hard_ceiling = 16000
context_window = 1048576
max_turns = 25
stall_threshold_seconds = 600

[executors.zai-glm]
key_env = "Z_AI_API_KEY"
key_account = "z_ai_api_key"
wrapper = "zai.sh"
provider = "zai"
model_id = "glm-5.3"
allowed_modes = ["breakout", "task", "consult"]
capabilities = []  # GLM does not accept image input through the agentic wrapper.
allowed_seats_in_breakout = ["engineer", "review"]
default_thinking_tokens = 32768
thinking_hard_ceiling = 65536
context_window = 1000000
max_turns = 25
stall_threshold_seconds = 300

[executors.minimax-m3]
wrapper = "gjc-minimax-m3.sh"
provider = "gjc"
model_id = "minimax-code/minimax-m3"
allowed_modes = ["breakout", "task"]
capabilities = []
allowed_seats_in_breakout = ["engineer"]
default_thinking_tokens = 0
thinking_hard_ceiling = 8000
context_window = 512000
max_turns = 25
stall_threshold_seconds = 300

# Retired 2026-06-12: minimax-m25 / minimax-m25-highspeed (legacy M2.5 lanes —
# the `minimax` lane is MiniMax-M3 on the same key; m25 also inherited a
# poisoned ANTHROPIC_BASE_URL via its ${VAR:-default} pattern) and
# minimax-coding-plan (separate stale CUSTOM_MINIMAX_CODING_PLAN_API_KEY,
# duplicated minimax M3). See fix/dispatch-lane-health.

[executors.codex-luna]
wrapper = "codex-luna.sh"
provider = "openai-codex"
model_id = "gpt-5.6-luna"
allowed_modes = ["breakout", "task", "consult"]
capabilities = ["vision"]
allowed_seats_in_breakout = ["top", "review", "leaf", "engineer"]
default_thinking_tokens = 0
