# ============================================================
# Auto-routing heuristics
# ============================================================
# Consulted by the auto-router when no explicit executor is set.
# Keys are signal names, values are executor preferences.

[auto_route]
# Ordered candidate lists per tier. The router returns the first executor that
# is mode-allowed AND available AND not in cooldown.
# Grok 4.5 replaces retired Claude Opus-class work: hard tasks, breakouts, and
# consults prefer `grok-build`. Unclassified standard work remains Z.ai-first.
# Within Codex,
# an unsatisfactory Luna result advances explicitly to Terra high and then, only
# if justified, Sol low/medium/high. Availability routing cannot infer whether a
# semantically valid answer was good enough.
trivial_candidates        = ["ollama-xps-gpu", "kilo-free-auto", "unsloth-nucbox", "zai-glm", "minimax-m3", "codex-luna", "codex-terra", "codex-sol"]
standard_candidates       = ["zai-glm", "unsloth-nucbox", "minimax-m3", "codex-luna", "codex-terra", "codex-sol", "grok-build", "agy-gemini-flash"]
local_general_candidates  = ["unsloth-nucbox", "qwen35-35b-general", "zai-glm", "minimax-m3", "codex-luna", "codex-terra", "codex-sol"]
local_review_candidates   = ["qwen35-27b-review", "unsloth-nucbox", "zai-glm", "codex-luna", "codex-terra", "codex-sol", "grok-build"]
local_coding_candidates   = ["unsloth-nucbox", "qwen36-35b-coding", "zai-glm", "minimax-m3", "codex-luna", "codex-terra", "codex-sol", "grok-build"]
hard_task_candidates      = ["grok-build", "codex-luna", "codex-terra", "codex-sol", "zai-glm", "agy-gemini-pro", "kimi-k3-cli", "kimi-k3-ollama"]
hard_breakout_candidates  = ["grok-build", "codex-luna", "codex-terra", "codex-sol", "zai-glm", "agy-gemini-pro", "kimi-k3-cli", "kimi-k3-ollama"]
long_context_candidates   = ["kimi-k3-cli", "kimi-k3-ollama", "codex-luna", "codex-terra", "codex-sol", "grok-build", "zai-glm", "agy-gemini-pro", "minimax-m3"]
consult_candidates        = ["grok-build", "codex-luna", "codex-terra", "codex-sol", "agy-gemini-pro", "zai-glm", "kimi-k3-cli", "kimi-k3-ollama"]

# Back-compat single-value keys (read only if the matching *_candidates list is
# absent). Kept so older tooling / partial matrices still resolve.
long_context_executor = "kimi-k3-cli"
long_context_threshold_tokens = 50000
trivial_executor = "ollama-xps-gpu"
trivial_threshold_tokens = 5000
local_general_max_tokens = 24000
local_review_max_tokens = 5000
local_coding_max_tokens = 16000
hard_coding_breakout_executor = "grok-build"
hard_coding_task_executor = "grok-build"
default_breakout = "grok-build"
default_task = "codex-luna"
default_consult = "grok-build"

# Learning loop: when true, candidate ordering is re-biased by outcomes.jsonl
# history (success rate / cost per tier). Off by default; enable after data
# accumulates.
learning = false

# ============================================================
# Nested dispatch configuration
# ============================================================

[nested_dispatch]
# Maximum nesting depth. Design target: 3. Now at 2 for orchestrator ->
# sub-orchestrator -> workers. Availability + cooldown filtering applies to
# child dispatches too; self-dispatch remains denied.
max_depth = 2

# Feature flag: set DISPATCH_NESTED=1 env var to enable.
# When off, --parent-id and --depth flags are silently ignored.

[nested_dispatch.permissions]
# Format: parent.child = true|false
# Missing entries are treated as denied.
# Self-dispatch is always denied regardless of matrix entries.
"codex-sol.codex-terra" = true
"codex-sol.codex-luna" = true
"codex-sol.kimi-k3-cli" = true
"codex-sol.kimi-k3-ollama" = true
"codex-sol.zai-glm" = true
"codex-sol.agy-gemini-pro" = true
"codex-sol.agy-gemini-flash" = true
"codex-sol.minimax-m3" = true
"codex-sol.kilo-free-auto" = true
"codex-sol.lm-studio" = true
"codex-terra.codex-luna" = true
"codex-terra.kilo-free-auto" = true
"codex-terra.lm-studio" = true
"kimi-k3-cli.codex-luna" = true
"kimi-k3-cli.kilo-free-auto" = true
"kimi-k3-cli.lm-studio" = true
"zai-glm.codex-luna" = true
"zai-glm.agy-gemini-flash" = true
"zai-glm.minimax-m3" = true
"zai-glm.kilo-free-auto" = true
"minimax-m3.codex-luna" = true
"minimax-m3.kilo-free-auto" = true
